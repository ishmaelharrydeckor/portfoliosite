# Copy this file to .env.local to run the site locally. On Vercel, add the same names under
# Settings > Environment Variables instead. NEVER commit real values: this file holds placeholders only.

# ---- Email (contact form and testimonial form) ----------------------------------------------
# Gmail example. SMTP_PASS must be a Google "App Password" (needs 2-Step Verification), NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
# Where the messages arrive. Defaults to SMTP_USER if left out.
SMTP_TO=you@gmail.com

# ---- Site address and search engines (see README) -------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# NEXT_PUBLIC_ALLOW_INDEXING=true

# ---- WhatsApp button (digits with country code, no + or spaces) -----------------------------
# NEXT_PUBLIC_WHATSAPP=
